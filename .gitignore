# Data never lives in this repo. It lives under $FISHYDATA — see R/paths.R.
# These patterns are belt-and-braces: the failure being designed out is a
# 360 GB tree accumulating inside a git repo again.
data/
data-raw/
data-dump/
*.parquet
*.gpkg
*.fgb
*.pmtiles
*.rds
*.zip
*.html
# support files of a standalone render (e.g. docs/ports.md -> ports.html)
docs/*_files/

# machine-local data root; each machine sets its own
.Renviron

# Scratch space for one-off maps and scripts; nothing here is part of the record.
/tmp/
